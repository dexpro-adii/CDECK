# CDECK / PromptKavach Environment Configuration

# Google Gemini API Key (Required for Hybrid Deep-Review escalation)
# Get a free key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Local Ollama model name for /explain-verdict
OLLAMA_MODEL=phi3:mini

# Combination strategy for multi-signal fusion: 'max' or 'consensus'
COMBINATION_STRATEGY=max

# Persistent AES-128-CBC encryption key for session PII vault
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CDECK_VAULT_KEY=your_fernet_vault_key_here

# Retired vault keys for seamless key rotation (comma-separated)
CDECK_VAULT_RETIRED_KEYS=
